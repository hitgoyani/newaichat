@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");body{font-family:Poppins,sans-serif}.fixed-div{width:250px;position:fixed;right:0;bottom:12px;background:#ff4500;z-index:111;padding:10px;border-radius:12px;margin-bottom:20px;margin-right:10px;text-align:center;border:2px solid #ff0}.animate-charcter{text-transform:uppercase;background-image:linear-gradient(-225deg,#fff,#fff 29%,#ff1361 100%,#fff800 0);background-size:auto auto;background-clip:border-box;background-size:200% auto;color:#fff;background-clip:text;text-fill-color:transparent;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:textclip 2s linear infinite;display:inline-block;font-size:190px}@keyframes textclip{to{background-position:200%}}.fixed-btn{background:#fff;padding:5px 20px;letter-spacing:1px;font-weight:600;display:inline-block;color:#000;border-radius:100px;text-decoration:none;background-size:200%;margin-top:10px;font-size:.7rem}.fixed-btn:hover{color:#ec5221!important}